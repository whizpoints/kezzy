# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# The Telegram Supergroup ID (must start with -100...)
TELEGRAM_GROUP_ID=-1001234567890

# Turso (libSQL) Database Configuration
# Get these from: turso db show <db-name> --url AND turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Web Server & Health Check
PORT=3000

# WhatsApp Baileys Session Identifier in DB
SESSION_ID=main_wa_session

# Optional: ID of the Telegram 'General' topic (default is 1)
GENERAL_TOPIC_ID=1
